# Backend AGRICAP FINTECH — moteur d'analyse crédit (Django)

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# IdP AGRICAP (OIDC) — validation des jetons déléguée à /userinfo.
IDP_ISSUER=http://localhost:8001
IDP_USERINFO_URL=http://localhost:8001/userinfo
# Durée de cache d'une résolution /userinfo (secondes).
IDP_USERINFO_CACHE_TTL=300

# Origines autorisées pour le SPA FINTECH (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Dossier des classeurs Excel de référence (pour l'amorçage CLI).
DOCUMENT_EXCEL_DIR=../Document Excel

# --- Analyse assistée par IA (hybride : calculs déterministes + IA sur les
#     verdicts/message/décision, en s'appuyant sur les documents de la plateforme).
# Sans clé, l'analyse reste 100 % déterministe (aucune régression).
AI_ANALYSIS_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Optionnel : point d'entrée et délai.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
AI_TIMEOUT=45
